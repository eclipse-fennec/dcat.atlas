-library: enableEMF


-buildpath: \
	osgi.core,\
	org.osgi.annotation.versioning,\
	org.osgi.annotation.bundle,\
	org.eclipse.fennec.dcat.atlas.dcatap.de.model;version=snapshot,\
	org.apache.jena.shacl;version=latest,\
	org.apache.jena.core;version=latest,\
	org.apache.jena.base;version=latest
# The runtime DTOs are plain org.osgi.dto.DTO and are asserted to stay that way: the
# round-trip test needs the converter, and the no-EMF test reads the package's own sources.
-testpath: \
	${junit},\
	junit-platform-launcher;version=latest,\
	org.osgi.util.converter;version=latest,\
	org.osgi.util.function;version=latest
