// Container configuration (F-23/F-24). Every value is env-driven via the Felix
// ConfigAdmin interpolation plugin, enabled by felix.cm.config.plugins in base.bndrun.
//
// Comments are legal here: Felix cm.json parses configurator resources through a
// comment-removing reader. Do not reintroduce the "//"-as-a-key idiom - the
// configurator logs every one of those at ERROR on each startup.
{
	":configurator:resource-version": 1,

	"org.apache.felix.http~dcatHttp": {
		"org.osgi.service.http.port": "$[env:HTTP_PORT;default=8080]",
		"org.osgi.service.http.host": "0.0.0.0",
		"org.apache.felix.http.context_path": "$[env:CONTEXT_PATH;default=/]",
		"org.apache.felix.http.name": "dcat",
		"org.apache.felix.http.runtime.init.id": "dcatHttp",
		"org.apache.felix.http.whiteboard.enable": true
	},
	"JakartarsServletWhiteboardRuntimeComponent~dcatRest": {
		"jersey.jaxrs.whiteboard.name": "dcatRest",
		"jersey.context.path": "rest",
		"osgi.http.whiteboard.target": "(id=dcatHttp)"
	},

	// F-25 probes. Liveness must never depend on the store or the shapes:
	// a restart does not mount a volume. Readiness is what stops traffic.
	"org.apache.felix.hc.core.impl.servlet.HealthCheckExecutorServlet~dcatLive": {
		"servletPath": "/health/live",
		"tags": ["live"],
		"format": "json",
		"httpStatusMapping": "OK:200,WARN:200,CRITICAL:503,TEMPORARILY_UNAVAILABLE:503,HEALTH_CHECK_ERROR:500"
	},
	"org.apache.felix.hc.core.impl.servlet.HealthCheckExecutorServlet~dcatReady": {
		"servletPath": "/health/ready",
		"tags": ["ready"],
		"format": "json",
		"httpStatusMapping": "OK:200,WARN:200,CRITICAL:503,TEMPORARILY_UNAVAILABLE:503,HEALTH_CHECK_ERROR:500"
	},
	"org.apache.felix.hc.generalchecks.ServicesCheck": {
		"hc.name": "services",
		"hc.tags": ["ready"],
		"services.list": ["(objectClass=org.eclipse.fennec.dcat.atlas.api.DcatValidationService)"],
		"statusForMissing": "CRITICAL"
	},

	// The one repository every store reads and writes (persistence plan Phase 2). The
	// mounted volume (F-23) is now a *bare* git repository rather than a directory of files:
	// commits go straight into the object database and leave a working tree untouched, so a
	// non-bare repo would show its whole tree as deleted. The image ships an initialised one
	// at /opt/dcat/store.git, which a fresh named volume is seeded from.
	//
	// Three modes, and GIT_REMOTE is what picks between the last two:
	//
	//   GIT_REPO=path                    the volume stands alone. No remote.
	//   GIT_REPO=path  GIT_REMOTE=url    durable on the volume AND mirrored upstream. This
	//                                    is the deployment shape to prefer: a commit is
	//                                    durable the moment it is written, and it also goes
	//                                    to the remote.
	//   GIT_REPO=url                     no volume; an in-memory mirror of that remote.
	//                                    The whole store is in the heap and grows (EU-7),
	//                                    and an unpushed commit dies with the process.
	//
	// Setting both GIT_REPO to a URL and GIT_REMOTE is refused rather than guessed at.
	//
	// basePath is the folder inside the repository; the four collection folders below it are
	// fixed, because they are the collection segment of every stored identity rather than a
	// storage detail. Distributions have no folder: dcat:distribution is containment, so
	// they live in their Dataset's blob (FR-10).
	"GitConfig~dcatStore": {
		"id": "dcatStore",
		"repo": "$[env:GIT_REPO;default=/opt/dcat/store.git]",
		"remote": "$[env:GIT_REMOTE;default=]",
		"branch": "$[env:GIT_BRANCH;default=main]",
		"authorName": "$[env:GIT_AUTHOR_NAME;default=DCAT.Atlas]",
		"authorEmail": "$[env:GIT_AUTHOR_EMAIL;default=dcat-atlas@example.org]",
		// Defaults to true, unlike the component's own default. For a local repository a push
		// is a no-op (GitServiceImpl skips it and says so), so the only thing this default
		// changes is the remote case - where leaving it off means every commit lives in the
		// heap-held repository and is gone at the next restart. An operator who wants to
		// batch pushes has to say so explicitly, which is the right way round.
		"pushOnCommit": "$[env:GIT_PUSH_ON_COMMIT;default=true]",
		"privateKey": "$[env:GIT_SSH_PRIVATE_KEY;default=]",
		"privateKeyPassphrase": "$[env:GIT_SSH_PRIVATE_KEY_PWD;default=]",
		"knownHosts": "$[env:GIT_SSH_KNOWN_HOSTS;default=]",
		"username": "$[env:GIT_USERNAME;default=]",
		"password": "$[env:GIT_PASSWORD;default=]"
	},

	"CatalogReadOnlyService": { "basePath": "$[env:STORE_BASE_PATH;default=dcat]", "gitService.target": "(id=dcatStore)" },
	"CatalogAdminService": { "basePath": "$[env:STORE_BASE_PATH;default=dcat]", "gitService.target": "(id=dcatStore)", "validateOnWrite": "$[env:MODEL_VALIDATE;default=true]", "validationService.cardinality.minimum:int": 1 },
	"DatasetReadOnlyService": { "basePath": "$[env:STORE_BASE_PATH;default=dcat]", "gitService.target": "(id=dcatStore)" },
	"DatasetAdminService": { "basePath": "$[env:STORE_BASE_PATH;default=dcat]", "gitService.target": "(id=dcatStore)", "validateOnWrite": "$[env:MODEL_VALIDATE;default=true]", "validationService.cardinality.minimum:int": 1 },
	"DataServiceReadOnlyService": { "basePath": "$[env:STORE_BASE_PATH;default=dcat]", "gitService.target": "(id=dcatStore)" },
	"DataServiceAdminService": { "basePath": "$[env:STORE_BASE_PATH;default=dcat]", "gitService.target": "(id=dcatStore)", "validateOnWrite": "$[env:MODEL_VALIDATE;default=true]", "validationService.cardinality.minimum:int": 1 },
	"DatasetSeriesReadOnlyService": { "basePath": "$[env:STORE_BASE_PATH;default=dcat]", "gitService.target": "(id=dcatStore)" },
	"DatasetSeriesAdminService": { "basePath": "$[env:STORE_BASE_PATH;default=dcat]", "gitService.target": "(id=dcatStore)", "validateOnWrite": "$[env:MODEL_VALIDATE;default=true]", "validationService.cardinality.minimum:int": 1 },
	"DistributionReadOnlyService": { "basePath": "$[env:STORE_BASE_PATH;default=dcat]", "gitService.target": "(id=dcatStore)" },
	"DistributionAdminService": { "basePath": "$[env:STORE_BASE_PATH;default=dcat]", "gitService.target": "(id=dcatStore)", "validateOnWrite": "$[env:MODEL_VALIDATE;default=true]", "validationService.cardinality.minimum:int": 1 },

	// Stored identities are host-free (http://dcat.atlas/...) so data is portable between
	// environments; this is the base they are rendered under at read time. It must be the
	// URL clients actually reach the portal on - behind a reverse proxy that is NOT the
	// address the container sees. ADDITIONAL_OWNED_BASES is a migration aid for absorbing
	// data written under an old hostname, and is normally empty.
	//
	// PUBLIC_BASE_URL has NO default, here or on the component, and the container will not
	// start without it. There is no value that is right for more than one deployment: it
	// becomes the host in every rendered 'about', so a default would have this container
	// advertising IRIs belonging to whatever host the default names - on every response,
	// each of which still looks perfectly well-formed. Refusing to start is the only
	// failure mode an operator can see.
	"PublicIris": {
		"publicBaseUrl": "$[env:PUBLIC_BASE_URL]",
		"additionalOwnedBases": "$[env:ADDITIONAL_OWNED_BASES;default=]"
	},

	// The SPARQL endpoint and the in-memory RDF projection behind it (WP-DCAT-5).
	// The projection is a disposable view of the store, so nothing here is persistent
	// state: switching it off costs only the endpoint, and the graph is rebuilt from
	// the files on every start. The timeout and row cap are the real protection
	// against an unbounded query — 'rooted' queries are an expectation, not a guard.
	"DcatGraphService": {
		"enabled": "$[env:SPARQL_ENABLED;default=true]",
		"queryTimeoutMillis": "$[env:SPARQL_QUERY_TIMEOUT_MS;default=30000]",
		"maxResultRows": "$[env:SPARQL_MAX_ROWS;default=10000]",
		"reconcileIntervalSeconds": "$[env:SPARQL_RECONCILE_INTERVAL_S;default=300]"
	},

	// The DCAT-AP.de shapes are AGPL-3.0 and are NOT in the image (see NOTICE.md):
	// the operator mounts them. The default points at the canonical mount path, so an
	// image started without that mount reports CRITICAL on /health/ready and never
	// becomes ready - a container must not silently serve an unvalidating portal.
	"DcatValidationService": {
		"shapesDirectory": "$[env:SHACL_SHAPES_DIR;default=/opt/dcat/shapes]",
		"vocabularyDirectory": "$[env:SHACL_VOCAB_DIR;default=/opt/dcat/vocabularies]",
		"enforceOnWrite": "$[env:SHACL_ENFORCE;default=true]"
	}
}
