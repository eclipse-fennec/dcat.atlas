// Container configuration (F-23/F-24). Every value is env-driven via the Felix
// ConfigAdmin interpolation plugin, enabled by felix.cm.config.plugins in base.bndrun.
//
// Comments are legal here: Felix cm.json parses configurator resources through a
// comment-removing reader. Do not reintroduce the "//"-as-a-key idiom - the
// configurator logs every one of those at ERROR on each startup.
{
	":configurator:resource-version": 1,

	"org.apache.felix.http~dcatHttp": {
		"org.osgi.service.http.port": "$[env:HTTP_PORT;default=8080]",
		"org.osgi.service.http.host": "0.0.0.0",
		"org.apache.felix.http.context_path": "$[env:CONTEXT_PATH;default=/]",
		"org.apache.felix.http.name": "dcat",
		"org.apache.felix.http.runtime.init.id": "dcatHttp",
		"org.apache.felix.http.whiteboard.enable": true
	},
	"JakartarsServletWhiteboardRuntimeComponent~dcatRest": {
		"jersey.jaxrs.whiteboard.name": "dcatRest",
		"jersey.context.path": "rest",
		"osgi.http.whiteboard.target": "(id=dcatHttp)"
	},

	// F-25 probes. Liveness must never depend on the store or the shapes:
	// a restart does not mount a volume. Readiness is what stops traffic.
	"org.apache.felix.hc.core.impl.servlet.HealthCheckExecutorServlet~dcatLive": {
		"servletPath": "/health/live",
		"tags": ["live"],
		"format": "json",
		"httpStatusMapping": "OK:200,WARN:200,CRITICAL:503,TEMPORARILY_UNAVAILABLE:503,HEALTH_CHECK_ERROR:500"
	},
	"org.apache.felix.hc.core.impl.servlet.HealthCheckExecutorServlet~dcatReady": {
		"servletPath": "/health/ready",
		"tags": ["ready"],
		"format": "json",
		"httpStatusMapping": "OK:200,WARN:200,CRITICAL:503,TEMPORARILY_UNAVAILABLE:503,HEALTH_CHECK_ERROR:500"
	},
	"org.apache.felix.hc.generalchecks.ServicesCheck": {
		"hc.name": "services",
		"hc.tags": ["ready"],
		"services.list": ["(objectClass=org.eclipse.fennec.dcat.atlas.api.DcatValidationService)"],
		"statusForMissing": "CRITICAL"
	},

	// One store root under the mounted volume (F-23); the per-collection subdirectories
	// are fixed, because a Catalog's dcat:dataset link is an EMF cross-resource reference
	// that has to resolve into the dataset store through one shared URI map. Distributions
	// have no directory: dcat:distribution is containment, so they live in their Dataset's
	// file (FR-10).
	"CatalogReadOnlyService": { "root": "$[env:STORE_FOLDER;default=/opt/dcat/data]" },
	"CatalogAdminService": { "root": "$[env:STORE_FOLDER;default=/opt/dcat/data]" },
	"DatasetReadOnlyService": { "root": "$[env:STORE_FOLDER;default=/opt/dcat/data]" },
	"DatasetAdminService": { "root": "$[env:STORE_FOLDER;default=/opt/dcat/data]" },
	"DataServiceReadOnlyService": { "root": "$[env:STORE_FOLDER;default=/opt/dcat/data]" },
	"DataServiceAdminService": { "root": "$[env:STORE_FOLDER;default=/opt/dcat/data]" },
	"DatasetSeriesReadOnlyService": { "root": "$[env:STORE_FOLDER;default=/opt/dcat/data]" },
	"DatasetSeriesAdminService": { "root": "$[env:STORE_FOLDER;default=/opt/dcat/data]" },
	"DistributionReadOnlyService": { "root": "$[env:STORE_FOLDER;default=/opt/dcat/data]" },
	"DistributionAdminService": { "root": "$[env:STORE_FOLDER;default=/opt/dcat/data]" },

	// Stored identities are host-free (http://dcat.atlas/...) so data is portable between
	// environments; this is the base they are rendered under at read time. It must be the
	// URL clients actually reach the portal on - behind a reverse proxy that is NOT the
	// address the container sees. ADDITIONAL_OWNED_BASES is a migration aid for absorbing
	// data written under an old hostname, and is normally empty.
	"PublicIris": {
		"publicBaseUrl": "$[env:PUBLIC_BASE_URL;default=http://localhost:8085/dcat/rest/]",
		"additionalOwnedBases": "$[env:ADDITIONAL_OWNED_BASES;default=]"
	},

	// The SPARQL endpoint and the in-memory RDF projection behind it (WP-DCAT-5).
	// The projection is a disposable view of the store, so nothing here is persistent
	// state: switching it off costs only the endpoint, and the graph is rebuilt from
	// the files on every start. The timeout and row cap are the real protection
	// against an unbounded query — 'rooted' queries are an expectation, not a guard.
	"DcatGraphService": {
		"enabled": "$[env:SPARQL_ENABLED;default=true]",
		"queryTimeoutMillis": "$[env:SPARQL_QUERY_TIMEOUT_MS;default=30000]",
		"maxResultRows": "$[env:SPARQL_MAX_ROWS;default=10000]",
		"reconcileIntervalSeconds": "$[env:SPARQL_RECONCILE_INTERVAL_S;default=300]"
	},

	// The DCAT-AP.de shapes are AGPL-3.0 and are NOT in the image (see NOTICE.md):
	// the operator mounts them. The default points at the canonical mount path, so an
	// image started without that mount reports CRITICAL on /health/ready and never
	// becomes ready - a container must not silently serve an unvalidating portal.
	"DcatValidationService": {
		"shapesDirectory": "$[env:SHACL_SHAPES_DIR;default=/opt/dcat/shapes]",
		"vocabularyDirectory": "$[env:SHACL_VOCAB_DIR;default=/opt/dcat/vocabularies]",
		"enforceOnWrite": "$[env:SHACL_ENFORCE;default=true]"
	}
}
