{
	":configurator:resource-version": 1,
	"GitConfig~dcatStore": {
		"id": "dcatStore",
		"repo": "$[env:GIT_REPO;default=/tmp/dcat-store.git]",
		"remote": "$[env:GIT_REMOTE;default=]",
		"branch": "$[env:GIT_BRANCH;default=main]",
		"authorName": "$[env:GIT_AUTHOR_NAME;default=DCAT.Atlas]",
		"authorEmail": "$[env:GIT_AUTHOR_EMAIL;default=dcat-atlas@example.org]",
		"pushOnCommit": "$[env:GIT_PUSH_ON_COMMIT;default=false]",
		"privateKey": "$[env:GIT_SSH_PRIVATE_KEY;default=$[prop:GIT_SSH_PRIVATE_KEY;default=]]",
		"privateKeyPassphrase": "$[env:GIT_SSH_PRIVATE_KEY_PWD;default=$[prop:GIT_SSH_PRIVATE_KEY_PWD;default=]]",
		"knownHosts": "$[env:GIT_SSH_KNOWN_HOSTS;default=$[prop:GIT_SSH_KNOWN_HOSTS;default=]]",
		"username": "$[env:GIT_USERNAME;default=]",
		"password": "$[env:GIT_PASSWORD;default=]"
	},
	"DcatGitStoreService": {
		"basePath": "$[env:STORE_BASE_PATH;default=dcat]",
		"gitService.target": "(id=dcatStore)",
		"validateOnWrite": "$[env:MODEL_VALIDATE;default=true]",
		"validationService.cardinality.minimum:int": 1
	},
	"PublicIris": {
		"publicBaseUrl": "$[env:PUBLIC_BASE_URL;default=http://localhost:8085/dcat/rest/]"
	},
	"DcatCallerHeader": {
		"caller.header": "$[env:CALLER_HEADER;default=X-Atlas-Client]"
	},
	"InitialDcatResources": {
		"folder": "$[env:INITIAL_RESOURCES_DIR;default=$[prop:INITIAL_RESOURCES_DIR;default=]]",
		"halt.on.error": false
	},

	"DcatGraphService": {
		"enabled": "$[env:SPARQL_ENABLED;default=true]",
		"queryTimeoutMillis": "$[env:SPARQL_QUERY_TIMEOUT_MS;default=30000]",
		"maxResultRows": "$[env:SPARQL_MAX_ROWS;default=10000]",
		"reconcileIntervalSeconds": "$[env:SPARQL_RECONCILE_INTERVAL_S;default=300]"
	},
	"DcatValidationService": {
		"shapesDirectory": "$[env:SHACL_SHAPES_DIR;default=$[prop:SHACL_SHAPES_DIR;default=/tmp/dcat-shapes-unset]]",
		"vocabularyDirectory": "$[env:SHACL_VOCAB_DIR;default=$[prop:SHACL_VOCAB_DIR;default=/tmp/dcat-vocab-unset]]",
		"enforceOnWrite": "$[env:SHACL_ENFORCE;default=true]"
	},

	"DcatReadOnlyService": {
		"storeService.target": "(component.name=DcatGitStoreService)"
	},

	"DcatAdminService": {
		"storeService.target": "(component.name=DcatGitStoreService)",
		"sparqlSupported": "$[env:SPARQL_ENABLED;default=true]",
		"graphService.cardinality.minimum:int": 1
	}
}
