{
  ":configurator:resource-version": 1,
   "org.apache.felix.http~maHttp": {
        "org.osgi.service.http.port": "8085",
        "org.osgi.service.http.host": "0.0.0.0",
        "org.apache.felix.http.context_path": "dcat/",
        "org.apache.felix.http.name": "dcat",
        "org.apache.felix.http.runtime.init.id": "dcatHttp",
        "org.apache.felix.http.whiteboard.enable": true
    },
	// A second Jetty connector, loopback only, whose URI rules allow exactly one more
	// violation than the main one: a percent-encoded '/' inside a path segment. That is
	// what an OData single-entity URL needs, because the key is the resource IRI.
	//
	// Not the runtime's own org.eclipse.jetty.UriComplianceMode property: Felix resolves
	// that with UriCompliance.valueOf, which takes only the six mode names - the narrowest
	// permitting an encoded separator is LEGACY, which permits seven others besides, on
	// every context. Measured here, that turns clean 400s on /rest into 500s.
	//
	// Jetty serves every context on every connector, so /rest answers on this port too,
	// under these looser rules. The isolation is the PORT, not the path: a gateway must
	// route only the OData paths here, and the bind address stays loopback.
	"DcatHttpConnector~dcatOData": {
		"port": 8186,
		"host": "localhost",
		"uriCompliance": "DEFAULT,AMBIGUOUS_PATH_SEPARATOR",
		"name": "dcatOData"
	},

	"org.apache.felix.hc.core.impl.servlet.HealthCheckExecutorServlet~dcatLive": {
		"servletPath": "/health/live",
		"tags": ["live"],
		"format": "json",
		"httpStatusMapping": "OK:200,WARN:200,CRITICAL:503,TEMPORARILY_UNAVAILABLE:503,HEALTH_CHECK_ERROR:500"
	},
	"org.apache.felix.hc.core.impl.servlet.HealthCheckExecutorServlet~dcatReady": {
		"servletPath": "/health/ready",
		"tags": ["ready"],
		"format": "json",
		"httpStatusMapping": "OK:200,WARN:200,CRITICAL:503,TEMPORARILY_UNAVAILABLE:503,HEALTH_CHECK_ERROR:500"
	},
	"org.apache.felix.hc.generalchecks.ServicesCheck": {
		"hc.name": "services",
		"hc.tags": ["ready"],
		"services.list": ["(objectClass=org.eclipse.fennec.dcat.atlas.api.validation.DcatValidationService)"],
		"statusForMissing": "CRITICAL"
	},
	"JakartarsServletWhiteboardRuntimeComponent~dcatRest": {
		"jersey.jaxrs.whiteboard.name": "dcatRest",
		"jersey.context.path": "rest",
		"osgi.http.whiteboard.target": "(id=dcatHttp)"
	},

	// The OData endpoint, beside /rest and /rest/sparql on the one HTTP runtime: the
	// context path makes it .../dcat/odata/. A factory configuration replaces the
	// servlet's unconfigured default root, which would publish every bound EPackage.
	//
	// Package order is load-bearing: the first one hosts the service's single entity
	// container, and binding order is otherwise arbitrary, so dcat comes first.
	// Entity sets are given as type IRIs - the nsURI with the type name appended, which
	// keeps a hash namespace's '#'. Each entry then names its own package instead of
	// being matched against all seven. The set is still called after its EClass, so the
	// URLs stay /Dataset and the like.
	"org.eclipse.fennec.odata.servlet~dcatOData": {
		"osgi.http.whiteboard.servlet.pattern": "/odata/*",
		"osgi.http.whiteboard.target": "(id=dcatHttp)",
		"odata.model.packages": [
			"http://www.w3.org/ns/dcat#",
			"http://www.w3.org/1999/02/22-rdf-syntax-ns#",
			"http://purl.org/dc/terms/",
			"http://xmlns.com/foaf/0.1/",
			"http://www.w3.org/2006/vcard/ns#",
			"http://spdx.org/rdf/terms#",
			"http://www.w3.org/ns/adms#"
		],
		"odata.model.entitysets": [
			"http://www.w3.org/ns/dcat#Catalog",
			"http://www.w3.org/ns/dcat#Dataset",
			"http://www.w3.org/ns/dcat#DatasetSeries",
			"http://www.w3.org/ns/dcat#DataService"
		]
	},

	// The request-limits filter guards one root, so it needs the same pattern and target
	// as the servlet it belongs to. Its shipped caps are the secure defaults and are left
	// alone; CORS stays off.
	"org.eclipse.fennec.odata.request.filter~dcatOData": {
		"osgi.http.whiteboard.filter.pattern": "/odata/*",
		"osgi.http.whiteboard.target": "(id=dcatHttp)"
	}
}