# Nothing is exported: this bundle contributes one service to the Felix Jetty runtime
# and has no API of its own.
#
# It is the only place in the workspace that compiles against Jetty. That is deliberate
# and is why it is its own bundle rather than a class in the odata one: the OData endpoint
# must stay usable on any HTTP implementation, and a Jetty import there would tie it to
# this one.

-buildpath: \
	org.apache.felix.http.jetty12;version=latest,\
	org.osgi.service.component;version=latest,\
	org.osgi.service.component.annotations;version=latest,\
	org.osgi.service.metatype.annotations;version=latest
