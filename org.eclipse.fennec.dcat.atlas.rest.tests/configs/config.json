{
  ":configurator:resource-version": 1,

  "org.apache.felix.http~testHttp": {
    "org.osgi.service.http.port": "8185",
    "org.osgi.service.http.host": "localhost",
    "org.apache.felix.http.context_path": "/",
    "org.apache.felix.http.name": "Dcat Atlas Test HTTP",
    "org.apache.felix.http.runtime.init.id": "testHttp"
  },
  "JakartarsServletWhiteboardRuntimeComponent~testRest": {
    "jersey.jakartars.whiteboard.name": "Dcat Atlas Test REST",
    "jersey.context.path": "rest",
    "name": "dcatatlas-test",
    "osgi.http.whiteboard.target": "(id=testHttp)"
  },
  "org.apache.felix.hc.core.impl.servlet.HealthCheckExecutorServlet~dcatLive": {
  	"servletPath": "/health/live",
  	"tags": ["live"],
  	"format": "json",
  	"httpStatusMapping": "OK:200,WARN:200,CRITICAL:503,TEMPORARILY_UNAVAILABLE:503,HEALTH_CHECK_ERROR:500"
  },
  "org.apache.felix.hc.core.impl.servlet.HealthCheckExecutorServlet~dcatReady": {
  	"servletPath": "/health/ready",
  	"tags": ["ready"],
  	"format": "json",
  	"httpStatusMapping": "OK:200,WARN:200,CRITICAL:503,TEMPORARILY_UNAVAILABLE:503,HEALTH_CHECK_ERROR:500"
  },
  "org.apache.felix.hc.generalchecks.ServicesCheck": {
  	"hc.name": "services",
  	"hc.tags": ["ready"],
  	"services.list": ["(objectClass=org.eclipse.fennec.dcat.atlas.api.validation.DcatValidationService)"],
  	"statusForMissing": "CRITICAL"
  },
  "GitConfig~dcatStore": {
    "id": "dcatStore",
    "repo": "$[env:GIT_REPO;default=/tmp/dcat-atlas-test-store.git]",
    "branch": "main",
    "authorName": "DCAT.Atlas Integration Tests",
    "authorEmail": "tests@dcat.atlas",
    "pushOnCommit": false,
    "privateKey": "",
    "privateKeyPassphrase": "",
    "knownHosts": "",
    "username": "",
    "password": ""
  },
  "CatalogReadOnlyService": { "basePath": "dcat", "gitService.target": "(id=dcatStore)" },
  "CatalogAdminService": { "basePath": "dcat", "gitService.target": "(id=dcatStore)" },
  "DatasetReadOnlyService": { "basePath": "dcat", "gitService.target": "(id=dcatStore)" },
  "DatasetAdminService": { "basePath": "dcat", "gitService.target": "(id=dcatStore)" },
  "DataServiceReadOnlyService": { "basePath": "dcat", "gitService.target": "(id=dcatStore)" },
  "DataServiceAdminService": { "basePath": "dcat", "gitService.target": "(id=dcatStore)" },
  "DatasetSeriesReadOnlyService": { "basePath": "dcat", "gitService.target": "(id=dcatStore)" },
  "DatasetSeriesAdminService": { "basePath": "dcat", "gitService.target": "(id=dcatStore)" },
  "DistributionReadOnlyService": { "basePath": "dcat", "gitService.target": "(id=dcatStore)" },
  "DistributionAdminService": { "basePath": "dcat", "gitService.target": "(id=dcatStore)" },
  "FormatBackfill": { "basePath": "dcat", "gitService.target": "(id=dcatStore)" },
  "PublicIris": { "publicBaseUrl": "http://localhost:8185/rest/" },
  // DcatCallerHeader is REQUIRE: without this block the admin resources have no
  // CallerHeader to bind and never register.
  "DcatCallerHeader": { "caller.header": "X-Atlas-Client" },
  // Explicit, not inherited: DcatGraphService is ConfigurationPolicy.REQUIRE and `enabled`
  // defaults to false, so SparqlEndpointIntegrationTest needs this block to have an endpoint.
  "DcatGraphService":             { "enabled": true },
  // Same reason: DcatODataRepository is REQUIRE with `enabled` false by default, so
  // ODataEndpointIntegrationTest needs this block to have a snapshot. The reconcile
  // timer is off - every test waits on the announced refresh, and a second rebuild
  // racing it would only make failures intermittent.
  "DcatODataRepository":          { "enabled": true, "reconcileIntervalSeconds": 0 },
  // The OData root, mirroring config.local/config.docker but on the test runtime. The
  // factory configuration replaces the servlet's unconfigured default root, which would
  // publish every bound EPackage; dcat is first because the first package hosts the
  // service's one entity container.
  "org.eclipse.fennec.odata.servlet~dcatOData": {
    "osgi.http.whiteboard.servlet.pattern": "/odata/*",
    "osgi.http.whiteboard.target": "(id=testHttp)",
    "odata.model.packages": [
      "http://www.w3.org/ns/dcat#",
      "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
      "http://purl.org/dc/terms/",
      "http://xmlns.com/foaf/0.1/",
      "http://www.w3.org/2006/vcard/ns#",
      "http://spdx.org/rdf/terms#",
      "http://www.w3.org/ns/adms#"
    ],
    "odata.model.entitysets": [
      "http://www.w3.org/ns/dcat#Catalog",
      "http://www.w3.org/ns/dcat#Dataset",
      "http://www.w3.org/ns/dcat#DatasetSeries",
      "http://www.w3.org/ns/dcat#DataService"
    ]
  },
  "org.eclipse.fennec.odata.request.filter~dcatOData": {
    "osgi.http.whiteboard.filter.pattern": "/odata/*",
    "osgi.http.whiteboard.target": "(id=testHttp)"
  },
  "DcatValidationService":        { "shapesDirectory": "$[env:SHACL_SHAPES_DIR;default=/tmp/dcat-shapes-unset]", "vocabularyDirectory": "$[env:SHACL_VOCAB_DIR;default=/tmp/dcat-vocab-unset]", "enforceOnWrite": "$[env:SHACL_ENFORCE;default=false]" }
}