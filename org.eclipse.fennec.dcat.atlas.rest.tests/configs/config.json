{
  ":configurator:resource-version": 1,

  "org.apache.felix.http~testHttp": {
    "org.osgi.service.http.port": "8185",
    "org.osgi.service.http.host": "localhost",
    "org.apache.felix.http.context_path": "/",
    "org.apache.felix.http.name": "Dcat Atlas Test HTTP",
    "org.apache.felix.http.runtime.init.id": "testHttp"
  },
  "JakartarsServletWhiteboardRuntimeComponent~testRest": {
    "jersey.jakartars.whiteboard.name": "Dcat Atlas Test REST",
    "jersey.context.path": "rest",
    "name": "dcatatlas-test",
    "osgi.http.whiteboard.target": "(id=testHttp)"
  },
  "CatalogReadOnlyService":       { "directory": "$[env:STORE_FOLDER;default=/tmp/rdf]/catalogs" },
  "CatalogAdminService":          { "directory": "$[env:STORE_FOLDER;default=/tmp/rdf]/catalogs" },
  "DatasetReadOnlyService":       { "directory": "$[env:STORE_FOLDER;default=/tmp/rdf]/datasets" },
  "DatasetAdminService":          { "directory": "$[env:STORE_FOLDER;default=/tmp/rdf]/datasets" },
  "DataServiceReadOnlyService":   { "directory": "$[env:STORE_FOLDER;default=/tmp/rdf]/data-services" },
  "DataServiceAdminService":      { "directory": "$[env:STORE_FOLDER;default=/tmp/rdf]/data-services" },
  "DataSeriesReadOnlyService":    { "directory": "$[env:STORE_FOLDER;default=/tmp/rdf]/dataset-series" },
  "DataSeriesAdminService":       { "directory": "$[env:STORE_FOLDER;default=/tmp/rdf]/dataset-series" },
  "DistributionReadOnlyService":  { "directory": "$[env:STORE_FOLDER;default=/tmp/rdf]/distributions" },
  "DistributionAdminService":     { "directory": "$[env:STORE_FOLDER;default=/tmp/rdf]/distributions" },
  "DcatValidationService":        { "shapesDirectory": "$[env:SHACL_SHAPES_DIR;default=/tmp/dcat-shapes-unset]" }
}