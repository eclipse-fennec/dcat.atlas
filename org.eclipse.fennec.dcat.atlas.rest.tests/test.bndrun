-library: enableOSGi-Test

-runrequires: \
	bnd.identity;id='org.eclipse.fennec.dcat.atlas.rest.tests',\
	bnd.identity;id='org.eclipse.fennec.dcat.atlas.impl',\
	bnd.identity;id='org.eclipse.fennec.dcat.atlas.msg.body.writer',\
	bnd.identity;id='org.eclipse.fennec.dcat.atlas.rest',\
	bnd.identity;id='org.eclipse.fennec.dcat.atlas.sparql',\
	bnd.identity;id='org.eclipse.fennec.dcat.atlas.validation',\
	bnd.identity;id='org.apache.felix.configadmin.plugin.interpolation',\
	bnd.identity;id='org.eclipse.parsson.jakarta.json',\
	bnd.identity;id='org.apache.felix.configadmin',\
	osgi.identity;filter:='(&(osgi.identity=org.apache.thrift)(version>=0.23.0))',\
	bnd.identity;id='org.apache.felix.healthcheck.api',\
	bnd.identity;id='org.apache.felix.healthcheck.core',\
	bnd.identity;id='org.apache.felix.healthcheck.generalchecks',\
	bnd.identity;id='org.eclipse.fennec.codec.rest',\
	bnd.identity;id='org.apache.felix.gogo.command',\
	bnd.identity;id='org.apache.felix.gogo.shell',\
	bnd.identity;id='org.eclipse.fennec.codec'
	
-runbundles.test: \
	org.eclipse.fennec.dcat.atlas.rest.tests;version=snapshot

-runfw: org.apache.felix.framework
-runee: JavaSE-21

# Jena's subsystem discovery is mediated by SPI-Fly via effective:=active
# osgi.serviceloader capabilities/requirements; resolve them so the providers
# and SPI-Fly are pulled into -runbundles.
-resolve.effective: active

-runproperties: \
	org.osgi.service.http.port=-1,\
	felix.cm.config.plugins=org.apache.felix.configadmin.plugin.interpolation,\
	${if;${is;${driver};gradle};gosh.args=--nointeractive}
	

-runbundles: \
	org.apache.aries.spifly.dynamic.bundle;version='[1.3.7,1.3.8)',\
	org.apache.felix.configadmin.plugin.interpolation;version='[1.2.8,1.2.9)',\
	org.apache.felix.configurator;version='[1.0.18,1.0.19)',\
