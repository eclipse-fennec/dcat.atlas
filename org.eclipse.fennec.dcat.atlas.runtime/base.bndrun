# org.eclipse.jgit.ssh.apache is required for a repository configured as an SSH remote. It is
# no longer needed merely to load the service - that was EU-9, fixed upstream 2026-08-19 by
# confining the sshd types to SshdSessionFactoryProvider - but it is still requested here so
# that switching GIT_REPO to an ssh:// or git@ remote works without re-resolving the runtime.
# The unit tests deliberately do NOT have it on their path, which is what proves EU-9 fixed.
-runrequires: \
	osgi.identity;filter:='(osgi.identity=org.apache.felix.gogo.shell)',\
	osgi.identity;filter:='(osgi.identity=org.apache.felix.gogo.command)',\
	bnd.identity;id='org.eclipse.fennec.dcat.atlas.impl',\
	bnd.identity;id='org.eclipse.fennec.jgit',\
	bnd.identity;id='org.eclipse.jgit.ssh.apache',\
	bnd.identity;id='org.eclipse.fennec.dcat.atlas.rest',\
	bnd.identity;id='org.eclipse.fennec.dcat.atlas.sparql',\
	bnd.identity;id='org.eclipse.fennec.dcat.atlas.msg.body.writer',\
	bnd.identity;id='org.apache.felix.healthcheck.api',\
	bnd.identity;id='org.apache.felix.healthcheck.core',\
	bnd.identity;id='org.apache.felix.healthcheck.generalchecks',\
	bnd.identity;id='org.eclipse.fennec.dcat.atlas.validation',\
	bnd.identity;id='org.apache.felix.configadmin.plugin.interpolation',\
	bnd.identity;id='org.apache.felix.configadmin',\
	bnd.identity;id='org.apache.felix.configurator',\
	bnd.identity;id='org.apache.thrift',\
	bnd.identity;id='org.eclipse.fennec.codec'
-runfw: org.apache.felix.framework;version='[7.0.5,7.0.5]'
-runee: JavaSE-21