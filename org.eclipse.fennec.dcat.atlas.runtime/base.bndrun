-runprovidedcapabilities: ${native_capability}

-resolve.effective: active;skip:="osgi.service"

# org.osgi.service.http.port=-1 keeps the *default* Jetty instance — the one JettyActivator
# starts from framework properties — from binding a port. Without it that instance takes 8080
# alongside the `org.apache.felix.http~*` factory instance we configure, wins the bind, and the
# Jakarta-RS whiteboard (which targets (id=dcatHttp)) ends up on a runtime nothing can reach.
# Factory configs set their own org.osgi.service.http.port and are unaffected.
# Same pattern as modelatlas.runtime_base.bndrun in model.atlas.
-runproperties: \
	org.osgi.service.http.port=-1,\
	felix.cm.config.plugins=org.apache.felix.configadmin.plugin.interpolation

