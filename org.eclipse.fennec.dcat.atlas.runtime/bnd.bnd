# The bndrun files here assemble the application from workspace bundles that are not
# on the -buildpath. bnd derives the build order (and the Gradle task graph for
# resolve.*/export.*) from -buildpath/-testpath only, so declare them explicitly or
# a Gradle build can resolve before those bundles are in the Workspace repo.
-dependson: \
	org.eclipse.fennec.dcat.atlas.api;version=snapshot,\
	org.eclipse.fennec.dcat.atlas.dcatap.de.model;version=snapshot,\
	org.eclipse.fennec.dcat.atlas.impl;version=snapshot,\
	org.eclipse.fennec.dcat.atlas.msg.body.writer;version=snapshot,\
	org.eclipse.fennec.dcat.atlas.rest;version=snapshot,\
	org.eclipse.fennec.dcat.atlas.sparql;version=snapshot,\
	org.eclipse.fennec.dcat.atlas.bootstrap;version=snapshot,\
	org.eclipse.fennec.dcat.atlas.validation;version=snapshot,\
	org.eclipse.fennec.dcat.atlas.config.local;version=snapshot,\
	org.eclipse.fennec.dcat.atlas.config.docker;version=snapshot


